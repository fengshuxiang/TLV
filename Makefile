# +------------+------------------------------+---------------------------+
# | 变量        | 说明                         | 示例                      |
# +------------+------------------------------+---------------------------+
# | CC         | 编译器                       | gcc                       |
# | CFLAGS     | 编译选项                     | make CFLAGS=-O2           |
# | TARGET     | 目标程序                     | make                      |
# +------------+------------------------------+---------------------------+

CC      := gcc
CFLAGS  := -Wall -Wextra -Werror -g
TARGET  := test_tlv

# +------------+------------------------------+---------------------------+
# | 目标        | 说明                         | 用法                      |
# +------------+------------------------------+---------------------------+
# | all        | 编译目标程序（默认）          | make                      |
# | clean      | 清理构建产物                  | make clean                |
# +------------+------------------------------+---------------------------+

all: $(TARGET)

$(TARGET): test_tlv.c tlv.h
	$(CC) $(CFLAGS) -o $@ test_tlv.c

clean:
	rm -f $(TARGET)
